# Google Maps Platform API Keys
# Frontend Maps JavaScript API Key (used securely for map display, markers, and controls)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Backend Google Maps API Key (used on server for Geocoding, Geolocation, and Places API New)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# GEMINI_API_KEY: Optional for Gemini AI itinerary chat and recommendations
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Google OAuth 2.0 Sign-In (optional)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
